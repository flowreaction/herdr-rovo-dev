#!/usr/bin/env bash
#
# rovo-herdr-hook - bridge Rovo Dev event hooks into Herdr agent state.
#
# Rovo invokes configured hook commands with a JSON payload on stdin. This
# script maps those lifecycle events to `herdr pane report-agent` calls.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./herdr-lib.sh
source "$SCRIPT_DIR/herdr-lib.sh"

require_jq >/dev/null 2>&1 || exit 0

payload="$(cat 2>/dev/null || true)"
[ -n "$payload" ] || exit 0

event_name="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
session_id="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"
prompt_text="$(printf '%s' "$payload" \
  | jq -r '(.attributes.prompt_text // .attributes.prompt // .prompt // empty) | strings' \
    2>/dev/null || true)"
tool_name="$(printf '%s' "$payload" \
  | jq -r '
      .attributes.tool_input.tool_name
      // .attributes.tool_calls[0].tool_name
      // .attributes.tool_results[0].tool_name
      // empty
    ' 2>/dev/null || true)"

pane_id="$(resolve_rovo_hook_pane "$cwd" 2>/dev/null || true)"
[ -n "$pane_id" ] || exit 0

# Track hook-pipeline liveness for this pane BEFORE any state for it becomes
# externally visible below, so scan-rovo-panes' scraping fallback can never
# race in during the hand-off and re-derive (and potentially clobber) state
# from screen text while wrongly believing no hook is active yet. A clean
# session end releases ownership only *after* its own final report (below),
# once this pane no longer has anything left to be authoritative about, so a
# later unrelated session reusing the same pane id has to re-earn hook trust
# from its own first event.
if [ "$event_name" != "on_session_end" ]; then
  mark_pane_hooked "$pane_id"
fi

# on_complete fires when Rovo's backend finishes generating a response, which
# can be seconds before the TUI finishes rendering it (see the settling note
# in herdr-lib.sh). Reporting idle/done here, synchronously, would tell Herdr
# the pane is quiet before the screen agrees. So this event reports nothing
# itself; it hands off to a detached settle task that polls the pane's actual
# rendered state and only then reports idle/done, guarded against a newer
# prompt superseding this completion in the meantime.
if [ "$event_name" = "on_complete" ]; then
  gen="$(current_generation "$pane_id")"
  (
    settle_and_report_complete "$pane_id" "$session_id" "$gen"
  ) </dev/null >/dev/null 2>&1 &
  exit 0
fi

if [ "$event_name" = "on_user_prompt" ]; then
  bump_generation "$pane_id" >/dev/null
elif [ "$event_name" = "on_session_start" ]; then
  clear_generation "$pane_id"
fi

state="unknown"
custom_status=""
message=""

case "$event_name" in
  on_session_start)
    state="idle"
    custom_status="session"
    message="Rovo Dev session started"
    ;;
  on_user_prompt)
    state="working"
    custom_status="prompt"
    message="Rovo Dev received a prompt"
    ;;
  on_tool_start)
    state="working"
    custom_status="$(short_status "tool:${tool_name:-running}")"
    message="Rovo Dev started ${tool_name:-a tool}"
    ;;
  on_tool_permission)
    state="blocked"
    custom_status="$(short_status "permission:${tool_name:-tool}")"
    message="Rovo Dev is waiting for permission"
    ;;
  on_tool_end)
    state="working"
    custom_status="$(short_status "tool-done:${tool_name:-tool}")"
    message="Rovo Dev finished ${tool_name:-a tool}"
    ;;
  on_error)
    state="blocked"
    custom_status="error"
    message="Rovo Dev hit an error"
    ;;
  on_session_end)
    state="idle"
    custom_status="exited"
    message="Rovo Dev session ended"
    ;;
  *)
    state="unknown"
    custom_status="$(short_status "$event_name")"
    message="Rovo Dev event: $event_name"
    ;;
esac

report_agent "$pane_id" "$state" "$custom_status" "$session_id" "$message" || true

if [ "$event_name" = "on_user_prompt" ]; then
  report_task_name "$pane_id" "$(short_prompt_label "$prompt_text")"
elif [ "$event_name" = "on_session_start" ]; then
  report_task_name "$pane_id"
fi

if [ "$event_name" = "on_session_end" ]; then
  clear_pane_hooked "$pane_id"
  clear_generation "$pane_id"
fi

exit 0
