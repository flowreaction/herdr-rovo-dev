#!/usr/bin/env bash
#
# rovo-herdr-hook - bridge Rovo Dev event hooks into Herdr agent state.
#
# Rovo invokes configured hook commands with a JSON payload on stdin. This
# script maps those lifecycle events to `herdr pane report-agent` calls.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./herdr-lib.sh
source "$SCRIPT_DIR/herdr-lib.sh"

require_jq >/dev/null 2>&1 || exit 0

payload="$(cat 2>/dev/null || true)"
[ -n "$payload" ] || exit 0

event_name="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
session_id="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"
tool_name="$(printf '%s' "$payload" \
  | jq -r '
      .attributes.tool_input.tool_name
      // .attributes.tool_calls[0].tool_name
      // .attributes.tool_results[0].tool_name
      // empty
    ' 2>/dev/null || true)"
pane_id="$(resolve_rovo_hook_pane "$cwd" "$session_id" 2>/dev/null || true)"
if [ -z "$pane_id" ]; then
  # No pane_id could be resolved at all (see resolve_rovo_hook_pane's
  # caveats). The legacy `pane report-agent` CLI call below genuinely cannot
  # run without one, but OSC 7501 is a tty-local protocol that needs no
  # pane_id (see rovo_event_osc_state/emit_agent_osc7501) - report via that
  # path alone instead of silently dropping the event.
  osc_state="" osc_kind=""
  read -r osc_state osc_kind <<< "$(rovo_event_osc_state "$event_name")"
  emit_agent_osc7501 "$osc_state" "$osc_kind"
  if [ "$event_name" = "on_session_start" ]; then
    schedule_delayed_osc_retry "$osc_state" "$osc_kind"
  fi
  exit 0
fi

# Nested sessions share the parent's pane. Their late tool events can arrive after
# the parent completes, so only the top-level session may control pane state.
rovo_session_is_top_level "$session_id" || exit 0

# Track hook-pipeline liveness for this pane BEFORE any state for it becomes
# externally visible below, so scan-rovo-panes' scraping fallback can never
# race in during the hand-off and re-derive (and potentially clobber) state
# from screen text while wrongly believing no hook is active yet. A clean
# session end releases ownership only *after* its own final report (below),
# once this pane no longer has anything left to be authoritative about, so a
# later unrelated session reusing the same pane id has to re-earn hook trust
# from its own first event.
if [ "$event_name" != "on_session_end" ]; then
  mark_pane_hooked "$pane_id"
fi

if [ -n "$session_id" ]; then
  report_session_title "$pane_id" "$session_id"
fi

if [ "$event_name" = "on_tool_start" ] && [ "$tool_name" = "ask_user_questions" ]; then
  mark_interactive_wait "$pane_id"
elif { [ "$event_name" = "on_tool_end" ] && [ "$tool_name" = "ask_user_questions" ]; } \
  || [ "$event_name" = "on_user_prompt" ]; then
  clear_interactive_wait "$pane_id"
fi

if interactive_wait_active "$pane_id"; then
  report_agent "$pane_id" "blocked" "input" "$session_id" "Rovo Dev is waiting for input" \
    "blocked" "question" || true
  exit 0
fi

# Rovo's on_complete event is authoritative. Reporting synchronously avoids a
# detached child being terminated by the hook runner and leaving the pane
# permanently marked as working.
if [ "$event_name" = "on_complete" ]; then
  # The Herdr app's OSC 7501 "done" state is exactly "finished while you
  # weren't looking" - a closer match than the legacy idle+custom_status
  # workaround below, which the classic herdr daemon still needs since it has
  # no distinct done state of its own.
  report_agent "$pane_id" "idle" "done" "$session_id" "Rovo Dev completed" \
    "done" || true
  exit 0
fi

state="unknown"
custom_status=""
message=""
# OSC 7501 state/kind for the Herdr app. Left empty for the catch-all branch
# below (an unmapped event has no valid 7501 word - see is_valid_osc_state -
# so report_agent silently skips the OSC report for it).
osc_state=""
osc_kind=""

case "$event_name" in
  on_session_start)
    state="idle"
    custom_status="session"
    message="Rovo Dev session started"
    osc_state="idle"
    ;;
  on_user_prompt)
    state="working"
    custom_status="prompt"
    message="Rovo Dev received a prompt"
    osc_state="working"
    ;;
  on_tool_start)
    state="working"
    custom_status="$(short_status "tool:${tool_name:-running}")"
    message="Rovo Dev started ${tool_name:-a tool}"
    osc_state="working"
    ;;
  on_tool_permission)
    state="blocked"
    custom_status="$(short_status "permission:${tool_name:-tool}")"
    message="Rovo Dev is waiting for permission"
    osc_state="blocked"
    osc_kind="permission"
    ;;
  on_tool_end)
    state="working"
    custom_status="$(short_status "tool-done:${tool_name:-tool}")"
    message="Rovo Dev finished ${tool_name:-a tool}"
    osc_state="working"
    ;;
  on_error)
    state="blocked"
    custom_status="error"
    message="Rovo Dev hit an error"
    # The Herdr app has a dedicated error state, unlike the legacy daemon
    # above (which has no distinct error state and keeps using blocked).
    osc_state="error"
    ;;
  on_session_end)
    state="idle"
    custom_status="exited"
    message="Rovo Dev session ended"
    osc_state="idle"
    ;;
  *)
    state="unknown"
    custom_status="$(short_status "$event_name")"
    message="Rovo Dev event: $event_name"
    ;;
esac

report_agent "$pane_id" "$state" "$custom_status" "$session_id" "$message" \
  "$osc_state" "$osc_kind" || true

if [ "$event_name" = "on_session_start" ]; then
  schedule_delayed_osc_retry "$osc_state" "$osc_kind"
fi

if [ "$event_name" = "on_session_end" ]; then
  clear_pane_hooked "$pane_id"
  clear_session_pane "$session_id"
fi

exit 0
